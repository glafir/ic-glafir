%h1 Station #{@station.name_rus}
%p#notice= notice
.col-6.col-md-6
  %table.table.table-striped.table-hover.table-condensed
    %thead
      %tr
        %th From
        %th To
        %th Время
    %tbody
      - @rw_eltrains_timetables.order(:time_start).order(:time_finish).where.not(time_start: nil, time_finish: nil).each do |ett|
        %tr
          %td
            = link_to ett.rw_eltrains_route.rw_route.rw_start_route.name_rus, "/rw_eltrains_timetables/show_eltrain/#{ett.eltrains_number}" if ett.direction == 0
            = link_to ett.rw_eltrains_route.rw_route.rw_end_route.name_rus, "/rw_eltrains_timetables/show_eltrain/#{ett.eltrains_number}" if ett.direction == 1
          %td
            = link_to ett.rw_eltrains_route.rw_route.rw_end_route.name_rus, "/rw_eltrains_timetables/show_eltrain/#{ett.eltrains_number}" if ett.direction == 0
            = link_to ett.rw_eltrains_route.rw_route.rw_start_route.name_rus, "/rw_eltrains_timetables/show_eltrain/#{ett.eltrains_number}" if ett.direction == 1
          %td
            = ett.time_finish.to_time.utc.to_s(:time) if ett.time_finish?
            - if ett.time_finish.nil?
              = ett.time_start.to_time.utc.to_s(:time) if ett.time_start?
              (нет посадки)
= link_to 'Edit', edit_station_path(@station)
\|
= link_to 'Back', stations_path

>
:javascript
  $(document).ready(function(){
      $('.table').DataTable( {
        retrieve: true,
        paging:   false,
        autoWidth: false,
        ordering: true,
        info:     false,
        stateSave: true,
        searching: false,
        order: [[ 2, "asc" ]]
      });
      $('.dataTables_length').addClass('bs-select');
  });
