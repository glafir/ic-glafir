%h1 Station #{@station.name_rus}
%p#notice= notice
= simple_form_for :direction_station, :method => 'get', html: { class: "form-inline", :id => "station_directions"} do |f|
  = f.select "Направления", options_from_collection_for_select(@station.rw_directions.order_by_direction_station, :id, :direction_station_name_rus, params[:direction_station]), prompt: "Все направления"

.col-6.col-md-6
  %table.table.table-striped.table-hover.table-condensed
    %thead
      %tr
        %th Train Number
        %th Время
        %th From
        %th To
    %tbody
      - @rw_eltrains_timetables.order(:time_start).order(:time_finish).where.not(time_start: nil, time_finish: nil).each do |ett|
        %tr
          - font_color = ett.eltrains_number.to_s.length == 3 ? "text-danger" : "text-info"
          %td= link_to ett.eltrains_number, "/rw_eltrains_timetables/show_eltrain/#{ett.eltrains_number}"
          - if ett.time_finish.nil?
            %td.text-nowrap.fs-10.text-muted
              = ett.time_start.to_time.utc.to_s(:time) if ett.time_start?
          - else
            %td.text-nowrap.fs-2.text-success
              = ett.time_finish.to_time.utc.to_s(:time) if ett.time_finish?
          %td.text-nowrap{:class => font_color}
            = ett.rw_eltrains_route.rw_route.rw_start_route.name_rus if ett.direction == 0
            = ett.rw_eltrains_route.rw_route.rw_end_route.name_rus if ett.direction == 1
          %td.text-nowrap{:class => font_color}
            = ett.rw_eltrains_route.rw_route.rw_end_route.name_rus if ett.direction == 0
            = ett.rw_eltrains_route.rw_route.rw_start_route.name_rus if ett.direction == 1
= link_to 'Edit', edit_station_path(@station)
\|
= link_to 'Back', stations_path

>
:javascript
  $(document).ready(function(){
      $('.table').DataTable( {
        retrieve: true,
        paging:   false,
        autoWidth: false,
        ordering: true,
        info:     false,
        stateSave: true,
        searching: false,
        order: [[ 1, "asc" ]]
      });
      $('.dataTables_length').addClass('bs-select');
  });
