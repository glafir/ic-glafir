- model_class = RwEltrainsTimetable
.page-header
  %h1=t '.title', :default => model_class.model_name.human.pluralize.titleize

%h1 Listing rw_eltrains_timetables

%table.table.table-striped.table-hover.table-condensed
  %thead
    %tr
      %th Station
      %th Direction
      %th Time start
      %th Time finish
      %th W1
      %th W2
      %th W3
      %th W4
      %th W5
      %th W6
      %th W0
      %th
      %th
      %th

  %tbody
    - @rw_eltrains_timetables.each do |rw_eltrains_timetable|
      %tr
        %td= rw_eltrains_timetable.station_id
        %td= rw_eltrains_timetable.direction
        %td= rw_eltrains_timetable.time_start
        %td= rw_eltrains_timetable.time_finish
        %td= rw_eltrains_timetable.w1
        %td= rw_eltrains_timetable.w2
        %td= rw_eltrains_timetable.w3
        %td= rw_eltrains_timetable.w4
        %td= rw_eltrains_timetable.w5
        %td= rw_eltrains_timetable.w6
        %td= rw_eltrains_timetable.w0
        %td= link_to 'Show', rw_eltrains_timetable
        %td= link_to 'Edit', edit_rw_eltrains_timetable_path(rw_eltrains_timetable)
        %td= link_to 'Destroy', rw_eltrains_timetable, :method => :delete, :data => { :confirm => 'Are you sure?' }

= link_to t('.new', :default => t("helpers.links.new")), new_rw_eltrains_timetable_path, :class => 'btn btn-primary'

