- model_class = RwEltrainsTimetable
.page-header
  %h1=t '.title', :default => model_class.model_name.human.pluralize.titleize

- @rw_routes.each do |rw_route|
  %p #{rw_route.rw_start_route.name_rus} - #{rw_route.rw_end_route.name_rus} #{link_to 'Добавить поезд', "/rw_eltrains_timetables/add_eltrain/#{rw_route.id}" }
  %table.table.table-striped.table-hover.table-condensed
    %thead
      %tr
        %th Trains_Number
        - rw_route.rw_eltrains_routes.order(:priority_direct).each do |rw_eltrains_route|
          %th= link_to rw_eltrains_route.station.name_rus, rw_eltrains_route.station
    %tbody
      - rw_route.rw_eltrains_routes.order(:priority_direct).where(station_id: rw_route.rw_start_route.id).each do |r|
        - r.rw_eltrains_timetables.where(station_id: rw_route.rw_start_route.id).where(direction: 0).order(:time_finish).each do |t|
          %tr
            %td= t.eltrains_number
            - tt1 = RwEltrainsTimetable.where(eltrains_number: t.eltrains_number)
            - tt1.each do |tt|
              %td
                = tt.time_finish.to_time.utc.to_s(:time) if tt.time_finish?
                - if tt.time_finish.nil?
                  = tt.time_start.to_time.utc.to_s(:time) if tt.time_start?

  %p #{rw_route.rw_end_route.name_rus} - #{rw_route.rw_start_route.name_rus} #{link_to 'Добавить поезд', "/rw_eltrains_timetables/add_eltrain/#{rw_route.id}" }
  %table.table.table-striped.table-hover.table-condensed
    %thead
      %tr
        %th Trains_Number
        - rw_route.rw_eltrains_routes.order(priority_direct: :desc).each do |rw_eltrains_route|
          %th= link_to rw_eltrains_route.station.name_rus, rw_eltrains_route.station
    %tbody
      - rw_route.rw_eltrains_routes.order(priority_direct: :desc).where(station_id: rw_route.rw_end_route.id).each do |r|
        - r.rw_eltrains_timetables.where(station_id: rw_route.rw_end_route.id).where(direction: 1).order(:time_finish).each do |t|
          %tr
            %td= t.eltrains_number
            - @tt = RwEltrainsTimetable.where(eltrains_number: t.eltrains_number)
            - @tt.each do |tt|
              %td
                = tt.time_finish.to_time.utc.to_s(:time) if tt.time_finish?
                - if tt.time_finish.nil?
                  = tt.time_start.to_time.utc.to_s(:time) if tt.time_start?

= link_to t('.new', :default => t("helpers.links.new")), new_rw_eltrains_timetable_path, :class => 'btn btn-primary'

