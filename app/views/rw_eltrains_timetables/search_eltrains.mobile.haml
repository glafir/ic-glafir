= simple_form_for :search_eltrains, :method => 'get' do |f|
  .form-inputs
    - if  params[:search_eltrains].nil?
      = f.input :station_start, :as => :autocomplete, :source_query => autocomplete_station_name_rus_stations_path, 'data-auto-focus' =>true, :items => 20
      = f.input :station_finish, :as => :autocomplete, :source_query => autocomplete_station_name_rus_stations_path, 'data-auto-focus' => true, :items => 20
    - else
      = f.input :station_start, :as => :autocomplete, :source_query => autocomplete_station_name_rus_stations_path, 'data-auto-focus' =>true, :items => 20, :value => params[:search_eltrains][:station_start_id]
      = f.input :station_finish, :as => :autocomplete, :source_query => autocomplete_station_name_rus_stations_path, 'data-auto-focus' => true, :items => 20, :value => params[:search_eltrains][:station_finish_id]
  .form-actions
    = f.button :submit, "Search ElTrains", class: "btn btn-info"
-if @search_eltrains_all
  = link_to  "Поискать обратные рейсы", "/rw_eltrains_timetables/search_eltrains?utf8=%E2%9C%93&search_eltrains%5Bstation_start_id%5D=#{@station_finish.id}&search_eltrains%5Bstation_start%5D=#{ERB::Util.url_encode(@station_finish.name_rus)}&search_eltrains%5Bstation_finish_id%5D=#{@station_start.id}&search_eltrains%5Bstation_finish%5D=#{ERB::Util.url_encode(@station_start.name_rus)}&commit=Search+ElTrains", :class => "btn btn-info"
  .col-12.col-md-12
    %h4 Результаты поиска по маршруту 
    %h5 #{@station_start.name_rus} - #{@station_finish.name_rus}
    %table.table.table-striped.table-hover.table-condensed
      %thead
        %tr
          %th Train Number
          %th From - To
          %th= @station_start.name_rus
          %th= @station_finish.name_rus
          %th Впемя в пути
      %tbody
        - @search_eltrains_all.sort_by(&:station_start_time).each do |s|
          %tr
            %td.col-1=link_to s.eltrains_number, "/rw_eltrains_timetables/show_eltrain/#{s.eltrains_number}"
            %td.text-nowrap
              #{s.rw_route.rw_start_route.name_rus} - 
              #{s.rw_route.rw_end_route.name_rus}
            %td.col-1= s.station_start_time.to_time.utc.to_s(:time)
            %td.col-1= s.station_finish_time.to_time.utc.to_s(:time)
            %td.text-nowrap.fs-10.text-info
              #{Time.diff(Time.parse(s.station_start_time.to_s), Time.parse(s.station_finish_time.to_s), '%h ч. %m мин')[:diff]}
