%h1 Adding Train to route #{@rw_route.id}
%h3 #{@rw_route.rw_start_route.name_rus} - #{@rw_route.rw_end_route.name_rus}

= form_with url: create_bulk_rw_eltrains_timetables_path, method: :post, local: true do |f| 
  = f.label :direction
  = f.check_box(:direction,{id: "direction_checkbox", data: {checkbox_toggle_target: "checkbox", action: "change->checkbox-toggle#toggle"}},1,0)
  = f.label :eltrains_number
  = f.number_field :eltrains_number, id: 'eltrains_number', data: {action: "change->form-updater#updateFields keyup->form-updater#updateFields", form_updater_target: "source" }
  = f.hidden_field :rw_route_id, :value => @rw_route.id

  %table.table.table-striped.table-hover.table-condensed
    %thead
      %tr
        %th Stations
        %th Time Start
        %th Time End
        %th Day Of Week
    %tbody
      - @rw_route.rw_eltrains_routes.each_with_index do |rw_el, i|
        = f.fields_for :rw_eltrains_timetables, index: i do |pf|
          %tr
            %td
              = rw_el.station.name_rus
              = pf.hidden_field :station_id, :value => rw_el.station.id
              = pf.hidden_field :rw_eltrains_route_id, :value => rw_el.id
              = pf.hidden_field :direction, :class => 'rw_eltrains_timetables_direction', data: {checkbox_toggle_target: "field", checked_value: "1", unchecked_value: "0" }
              = pf.hidden_field :eltrains_number, :class => 'rw_eltrains_timetables_eltrains_number', data: { form_updater_target: "rw_eltrains_timetables_eltrains_number" }

            %td= pf.time_field :time_start
            %td= pf.time_field :time_finish
            %td
              = pf.check_box(:w1,{checked: "checked"},1,0)
              = pf.check_box(:w2,{checked: "checked"},1,0)
              = pf.check_box(:w3,{checked: "checked"},1,0)
              = pf.check_box(:w4,{checked: "checked"},1,0)
              = pf.check_box(:w5,{checked: "checked"},1,0)
              = pf.check_box(:w6,{checked: "checked"},1,0)
              = pf.check_box(:w0,{checked: "checked"},1,0)

  = f.submit nil, class: 'btn btn-primary'
:javascript
  var elems = Array.prototype.slice.call(document.querySelectorAll("input[type=checkbox]"));
      elems.forEach(function(elem) {
      var switchery = new Switchery(elem,{
      color: '#00a1d2',
      jackColor: '#22c3f3',
      secondaryColor: '#505050',
      jackSecondaryColor: '#606060'
    });
  });

:javascript
  document.getElementById("direction_checkbox").addEventListener("change", function() {
    const isChecked = this.checked;
    document.querySelectorAll(".rw_eltrains_timetables_direction").forEach(input => {
      input.value = isChecked ? 1 : 0;
    });
  });
  document.getElementById("eltrains_number").addEventListener('input', (event) => {
    document.querySelectorAll(".rw_eltrains_timetables_eltrains_number").forEach(input_h => {
      input_h.value = parseInt(event.target.value) || 0;
    });
  });


