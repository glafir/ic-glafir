- wcount = @weathers.count*1.25
- unless @weathers.count < 3
  .w_info
    %p= tmax = (@weathers.map { |d|d.temperature}.max - 273.15).to_f.round(1)
    %p= tmin = (@weathers.map { |d|d.temperature}.min - 273.15).to_f.round(1)
    - tamp = tmax - tmin
    - ycorr = 0 - tmin
  #weather-chart
    =line_chart @weathers_graph, {width: '1100px', height: '500px'}
